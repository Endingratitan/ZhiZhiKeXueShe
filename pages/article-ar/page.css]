
/* ---------- 加载提示的跳动小点 ---------- */
.art-dots {
    display: inline-flex;
    gap: 4px;
    margin-left: 6px;
    vertical-align: middle;
}
.art-dots i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    animation: art-dot-bounce 1.2s infinite ease-in-out;
}
.art-dots i:nth-child(2) { animation-delay: 0.15s; }
.art-dots i:nth-child(3) { animation-delay: 0.3s; }
@keyframes art-dot-bounce {
    0%, 70%, 100% { opacity: 0.25; transform: translateY(0); }
    35% { opacity: 1; transform: translateY(-3px); }
}
@media (prefers-reduced-motion: reduce) {
    .art-dots i { animation: none; opacity: 0.6; }
}
